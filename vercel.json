{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/styles.:hash([0-9a-f]{12}).css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:folder(logos|photos)/:name([a-z0-9-]+).:hash([0-9a-f]{12}).:ext(webp|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:icon(favicon|favicon-32|apple-touch-icon|icon-512|logo-256).:ext(ico|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
